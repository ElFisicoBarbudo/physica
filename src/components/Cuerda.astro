---
// Interferencia de ondas para la portada: dos ondas viajeras de distinta frecuencia se superponen
// y la resultante (en amarillo) se apaga suavemente hacia los extremos. Es decorativa: sin interacción.
---

<figure class="ondas" data-ondas>
  <svg viewBox="0 0 1000 160" preserveAspectRatio="none" aria-hidden="true">
    <path class="onda onda-a" d="" />
    <path class="onda onda-b" d="" />
    <path class="onda onda-suma" d="" />
  </svg>
  <button type="button" class="pausa" aria-pressed="false">
    <span data-texto>Pausar animación</span>
  </button>
</figure>

<script>
  const W = 1000;
  const MEDIO = 80;
  const PUNTOS = 200;

  type Onda = [amplitud: number, ondas: number, velocidad: number, fase: number];
  const A: Onda = [34, 2.5, 0.7, 0];
  const B: Onda = [26, 4, -0.5, 1.4];

  const onda = ([amp, k, w, f]: Onda, x: number, t: number) => amp * Math.sin(2 * Math.PI * k * (x / W) - w * t + f);
  // Ventana: 0 en los bordes y 1 en el centro, para que la onda nazca y muera sin cortes.
  const ventana = (x: number) => Math.pow(Math.sin(Math.PI * (x / W)), 0.8);

  for (const fig of document.querySelectorAll<HTMLElement>('[data-ondas]')) {
    const a = fig.querySelector<SVGPathElement>('.onda-a')!;
    const b = fig.querySelector<SVGPathElement>('.onda-b')!;
    const suma = fig.querySelector<SVGPathElement>('.onda-suma')!;
    const pausa = fig.querySelector<HTMLButtonElement>('.pausa')!;
    const texto = fig.querySelector<HTMLElement>('[data-texto]')!;
    const quieta = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let visible = true;
    let pausada = quieta;
    let t = 1.2;
    let anterior = performance.now();

    const trazo = (f: (x: number) => number) => {
      let d = '';
      for (let i = 0; i <= PUNTOS; i++) {
        const x = (i / PUNTOS) * W;
        d += `${i ? 'L' : 'M'}${x.toFixed(1)} ${(MEDIO - f(x) * ventana(x)).toFixed(1)}`;
      }
      return d;
    };

    const dibujar = () => {
      a.setAttribute('d', trazo((x) => onda(A, x, t)));
      b.setAttribute('d', trazo((x) => onda(B, x, t)));
      suma.setAttribute('d', trazo((x) => (onda(A, x, t) + onda(B, x, t)) * 0.9));
    };

    const etiquetar = () => {
      pausa.setAttribute('aria-pressed', String(pausada));
      texto.textContent = pausada ? 'Reanudar animación' : 'Pausar animación';
    };

    pausa.addEventListener('click', () => {
      pausada = !pausada;
      anterior = performance.now();
      etiquetar();
    });

    dibujar();
    etiquetar();
    if (quieta) continue;

    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(fig);

    const paso = (ahora: number) => {
      const dt = Math.min(0.05, (ahora - anterior) / 1000);
      anterior = ahora;
      if (visible && !pausada && !document.hidden) {
        t += dt;
        dibujar();
      }
      requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);
  }
</script>

<style>
  .ondas {
    margin: 0;
  }

  svg {
    display: block;
    width: 100%;
    height: clamp(80px, 11vw, 130px);
    overflow: visible;
  }

  .onda {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .onda-a {
    stroke: rgb(255 255 255 / 0.3);
    stroke-width: 1.5;
  }

  .onda-b {
    stroke: rgb(255 255 255 / 0.18);
    stroke-width: 1.5;
  }

  .onda-suma {
    stroke: var(--senal);
    stroke-width: 3;
  }

  .pausa {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.25rem;
    padding: 0 0.25rem;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--banda-suave);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .pausa:hover {
    color: #fff;
    text-decoration: underline;
  }
</style>
