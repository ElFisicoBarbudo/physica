---
import type { CollectionEntry } from 'astro:content';
import { url, idiomaEn } from '../lib/util';

interface Props {
  cancion: CollectionEntry<'canciones'>;
}

const { cancion } = Astro.props;
const d = cancion.data;
---

<li class="tarjeta" data-temas={d.temas.join('|')}>
  <a href={url(`canciones/${cancion.id}/`)}>
    <div class="miniatura">
      {
        d.youtube ? (
          // hqdefault es 4:3 y trae barras negras arriba y abajo; maxresdefault es 16:9 limpia.
          // Si el vídeo no tiene maxres, YouTube devuelve un gris de 120 px: pasamos a mqdefault (16:9).
          <img
            src={`https://i.ytimg.com/vi/${d.youtube}/maxresdefault.jpg`}
            onload={`if(this.naturalWidth<=120)this.src='https://i.ytimg.com/vi/${d.youtube}/mqdefault.jpg'`}
            width="1280"
            height="720"
            alt=""
            loading="lazy"
          />
        ) : (
          <svg viewBox="0 0 160 90" aria-hidden="true" preserveAspectRatio="none">
            <path d="M0 45 C 20 10, 30 10, 40 45 S 60 80, 80 45 S 100 10, 120 45 S 140 80, 160 45" />
          </svg>
        )
      }
    </div>
    <p class="estilo">{[d.estilo, idiomaEn[d.idioma]].filter(Boolean).join(', ')}</p>
    <h3>{d.titulo}</h3>
    <p class="resumen">{d.resumen}</p>
    <ul class="etiquetas">{d.temas.map((t) => <li class="etiqueta">{t}</li>)}</ul>
  </a>
</li>

<style>
  .tarjeta {
    list-style: none;
  }

  .tarjeta a {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .miniatura {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radio);
    overflow: hidden;
    background: #151a3a;
    margin-bottom: 1rem;
  }

  .miniatura img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .miniatura > svg {
    width: 100%;
    height: 100%;
  }

  .miniatura path {
    fill: none;
    stroke: var(--senal);
    stroke-width: 3;
  }

  /* Al pasar por encima, la miniatura se enmarca con el color de acento. */
  .miniatura {
    outline: 3px solid transparent;
    outline-offset: 3px;
    transition: outline-color 0.2s ease;
  }

  .tarjeta a:hover .miniatura,
  .tarjeta a:focus-visible .miniatura {
    outline-color: var(--acento);
  }

  .tarjeta a:focus-visible {
    outline: none;
  }

  .tarjeta a:hover img {
    transform: scale(1.04);
  }

  .estilo {
    margin: 0 0 0.3rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--acento);
  }

  h3 {
    font-size: 1.55rem;
    margin: 0 0 0.5rem;
  }

  .tarjeta a:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }

  .resumen {
    margin: 0 0 0.9rem;
    color: var(--tinta-suave);
    font-size: 0.98rem;
    flex: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .miniatura,
    .miniatura img {
      transition: none;
    }
  }
</style>
