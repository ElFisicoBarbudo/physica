---
import type { CollectionEntry } from 'astro:content';
import { url, idiomaEn } from '../lib/util';

interface Props {
  cancion: CollectionEntry<'canciones'>;
}

const { cancion } = Astro.props;
const d = cancion.data;
---

<li class="tarjeta" data-temas={d.temas.join('|')}>
  <a href={url(`canciones/${cancion.id}/`)}>
    <div class="miniatura">
      {
        d.youtube ? (
          // hqdefault (480×360) trae barras negras arriba y abajo; con object-fit: cover en un marco 16:9 se recortan justo.
          // Pesa una fracción de maxresdefault y sobra para una tarjeta de ~340 px.
          <img src={`https://i.ytimg.com/vi/${d.youtube}/hqdefault.jpg`} width="480" height="360" alt="" loading="lazy" decoding="async" />
        ) : (
          <svg viewBox="0 0 160 90" aria-hidden="true" preserveAspectRatio="none">
            <path d="M0 45 C 20 10, 30 10, 40 45 S 60 80, 80 45 S 100 10, 120 45 S 140 80, 160 45" />
          </svg>
        )
      }
    </div>
    <div class="cuerpo">
      <p class="estilo">
        {[d.estilo, idiomaEn[d.idioma]].filter(Boolean).join(', ')}
      </p>
      <h3>{d.titulo}</h3>
      <p class="resumen">{d.resumen}</p>
      <ul class="etiquetas">{d.temas.map((t) => <li class="etiqueta">{t}</li>)}</ul>
    </div>
  </a>
</li>

<style>
  .tarjeta {
    list-style: none;
  }

  .tarjeta a {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: var(--tarjeta);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    box-shadow: var(--sombra-1);
    transition:
      transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  /* Reborde amarillo de señal: 1 px de borde + 2 px de anillo. El foco de teclado conserva su propio contorno cobalto. */
  .tarjeta a:hover {
    transform: translateY(-3px);
    border-color: var(--senal);
    box-shadow:
      0 0 0 2px var(--senal),
      var(--sombra-2);
  }

  .miniatura {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0d1450;
  }

  .miniatura img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .miniatura > svg {
    width: 100%;
    height: 100%;
  }

  .miniatura path {
    fill: none;
    stroke: var(--senal);
    stroke-width: 3;
  }

  .tarjeta a:hover img {
    transform: scale(1.04);
  }

  .cuerpo {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.1rem 1.25rem 1.3rem;
  }

  .estilo {
    margin: 0 0 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--acento);
  }


  h3 {
    font-size: 1.4rem;
    margin: 0 0 0.5rem;
  }

  .resumen {
    margin: 0 0 1rem;
    color: var(--tinta-suave);
    font-size: 0.97rem;
    flex: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta a,
    .miniatura img {
      transition: none;
    }

    .tarjeta a:hover,
    .tarjeta a:hover img {
      transform: none;
    }
  }
</style>
