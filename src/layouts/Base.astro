---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import BotonAzar from '../components/BotonAzar.astro';
import { NOMBRE, url } from '../lib/util';

interface Props {
  titulo?: string;
  descripcion?: string;
  claseBody?: string;
  /** Sección del menú que se marca como actual. */
  actual?: 'canciones' | 'conoceme';
}

const { titulo, descripcion = 'Canciones de física con videoclip, letra explicada verso a verso y fichas para usar en clase.', claseBody, actual } = Astro.props;
const [nombre1, ...resto] = NOMBRE.split(' ');
const nombre2 = resto.join(' ');
const tituloCompleto = titulo ? `${titulo} | ${NOMBRE}` : `${NOMBRE}: la física también se canta`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta name="theme-color" content="#2f3df4" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,500..800&display=swap"
      rel="stylesheet"
    />
    <!-- Syne solo se usa en la primera palabra del logo: se descargan únicamente esas letras. -->
    <link href={`https://fonts.googleapis.com/css2?family=Syne:wght@800&text=${encodeURIComponent(nombre1)}&display=swap`} rel="stylesheet" />
  </head>
  <body class={claseBody}>
    <div class="banda no-print">
      <header class="cabecera">
        <a class="marca" href={url('')}>
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M2 16c3-9 6-9 9 0s6 9 9 0 6-9 10 0" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg>
          <span class="marca-texto"><span>{nombre1}</span>{nombre2 && <span>{nombre2}</span>}</span>
        </a>
        <nav aria-label="Principal">
          <a href={url('#como-usar')}>En clase</a>
          <a href={url('#canciones')} aria-current={actual === 'canciones' ? 'page' : undefined}>Canciones</a>
          <a href={url('conoceme/')} aria-current={actual === 'conoceme' ? 'page' : undefined}>Conóceme</a>
          <BotonAzar class="nav-azar" texto="Al azar" />
        </nav>
      </header>
    </div>
    <slot />
    <footer class="pie no-print">
      <div class="pie-dentro envoltura">
        <div>
          <a class="marca" href={url('')}><span class="marca-texto"><span>{nombre1}</span>{nombre2 && <span>{nombre2}</span>}</span></a>
          <p>Un proyecto de divulgación de El Físico Barbudo. Las canciones, las explicaciones y las fichas son de uso libre en el aula.</p>
        </div>
        <nav aria-label="Pie">
          <a href={url('#canciones')}>Canciones</a>
          <a href={url('#como-usar')}>En clase</a>
          <a href={url('conoceme/')}>Conóceme</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
