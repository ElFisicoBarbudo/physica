---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BotonAzar from '../../components/BotonAzar.astro';
import { cancionesOrdenadas, idiomaEn, md, url, youtubeUrl } from '../../lib/util';

export async function getStaticPaths() {
  const canciones = await cancionesOrdenadas();
  return canciones.map((cancion, i) => ({
    params: { slug: cancion.id },
    props: { cancion, anterior: canciones[i - 1], siguiente: canciones[i + 1] },
  }));
}

const { cancion, anterior, siguiente } = Astro.props;
const d = cancion.data;
const todos = await getCollection('colaboradores');
const colaboradores = d.colaboradores.map((id) => todos.find((c) => c.id === id)).filter((c) => c !== undefined);
const conTraduccion = d.idioma !== 'es' && d.letra.some((s) => s.versos.some((v) => v.traduccion));
// En GitHub Actions se generan los PDF tras la compilación (ver scripts/generar-pdfs.mjs).
const hayPdf = import.meta.env.PUBLIC_FICHAS_PDF === 'true';
let n = 0;
---

<Base titulo={d.titulo} descripcion={d.resumen} actual="canciones">
  <main id="contenido" tabindex="-1">
  <div class="banda con-brillo cabeza">
    <div class="envoltura">
      <p class="migas"><a class="toque" href={url('#canciones')}>Todas las canciones</a></p>
      <p class="estilo">{[d.estilo, idiomaEn[d.idioma], d.anio, d.nivel].filter(Boolean).join(', ')}</p>
      <h1>{d.titulo}</h1>
      <p class="resumen">{d.resumen}</p>
      <ul class="temas">{d.temas.map((t) => <li>{t}</li>)}</ul>
    </div>
  </div>

  <div class="envoltura cancion">
    <div class="portada">
      <div class="portada-video">
        {
          d.youtube ? (
            <div class="video">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${d.youtube}`}
                title={`Videoclip de ${d.titulo}`}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                allowfullscreen
              />
            </div>
          ) : (
            <div class="video vacio">
              <p>El videoclip aparecerá aquí</p>
            </div>
          )
        }
        {d.avisos.map((a) => <p class="aviso">{a}</p>)}
        {d.ejemplo && <p class="aviso-ejemplo">Esta es una <strong>canción de ejemplo</strong> para enseñar cómo queda una página. Sustitúyela por una real.</p>}
        {d.borrador && <p class="aviso-ejemplo">La presentación y las explicaciones de esta canción están pendientes de revisión.</p>}
      </div>
      <aside class="recursos">
        <h2>Para clase</h2>
        {
          hayPdf ? (
            <a class="boton" href={url(`fichas/${cancion.id}.pdf`)} download>
              Descargar la ficha en PDF
            </a>
          ) : (
            <a class="boton" href={url(`canciones/${cancion.id}/ficha/`)}>
              Ficha para imprimir
            </a>
          )
        }
        {
          hayPdf && (
            <a class="boton secundario" href={url(`canciones/${cancion.id}/ficha/`)}>
              Ver la ficha en el navegador
            </a>
          )
        }
        <div class="escuchar">
          {
            d.youtube && (
              <a class="boton secundario toque" href={youtubeUrl(d.youtube)} target="_blank" rel="noopener">
                YouTube
              </a>
            )
          }
          {
            d.spotify && (
              <a class="boton secundario toque" href={d.spotify} target="_blank" rel="noopener">
                Spotify
              </a>
            )
          }
        </div>
        <ul class="indice">
          <li><a href="#presentacion">Presentación del tema</a></li>
          {d.letra.length > 0 && <li><a href="#letra">Letra explicada</a></li>}
          {d.actividades.length > 0 && <li><a href="#actividades">Actividades</a></li>}
          {d.referencias.length > 0 && <li><a href="#referencias">Para saber más</a></li>}
        </ul>
      </aside>
    </div>

    <nav class="barra-indice no-print" aria-label="Secciones de la canción">
      <ul>
        <li><a href="#presentacion">Presentación</a></li>
        {d.letra.length > 0 && <li><a href="#letra">Letra explicada</a></li>}
        {d.actividades.length > 0 && <li><a href="#actividades">Actividades</a></li>}
        {d.referencias.length > 0 && <li><a href="#referencias">Para saber más</a></li>}
      </ul>
    </nav>

    <section id="presentacion" class="bloque">
      <h2>Presentación del tema</h2>
      <div class="prosa presentacion" id="presentacion-texto" set:html={md(cancion.body ?? '')} />
      <button type="button" class="boton secundario leer-mas" id="leer-mas" aria-controls="presentacion-texto" aria-expanded="false" hidden>Leer más</button>
    </section>

    {
      d.letra.length > 0 && (
    <section id="letra" class="bloque">
        <h2>Letra explicada</h2>
        <div class="interruptores" role="group" aria-label="Opciones de la letra">
          {
            conTraduccion && (
              <label>
                <input type="checkbox" role="switch" data-alterna="con-traduccion" /> Traducción
              </label>
            )
          }
          <label><input type="checkbox" role="switch" data-alterna="con-explicaciones" /> Explicaciones</label>
        </div>
        <div class="letra" id="letra-contenido">
          {
            d.letra.map((s) => (
              <div class="seccion">
                {s.seccion && <h3>{s.seccion}</h3>}
                {s.versos.map((v) => {
                  const num = v.explicacion ? ++n : null;
                  return (
                    <div class:list={['verso', { explicado: v.explicacion }]} style={num ? `--i:${Math.min(num, 8)}` : undefined}>
                      <div class="original">
                        {num && <span class="marca-num" aria-hidden="true">{num}</span>}
                        <p class="texto">{v.texto.trim()}</p>
                        {v.traduccion && (
                          <div class="plegable plegable-traduccion">
                            <div>
                              <p class="traduccion">{v.traduccion.trim()}</p>
                            </div>
                          </div>
                        )}
                      </div>
                      {v.explicacion && (
                        <div class="plegable plegable-explicacion">
                          <div>
                            <div class="explicacion prosa" set:html={md(v.explicacion)} />
                          </div>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            ))
          }
        </div>
      </section>
      )
    }

    {
      d.actividades.length > 0 && (
        <section id="actividades" class="bloque">
          <h2>Actividades</h2>
          <ol class="actividades">
            {d.actividades.map((a) => (
              <li set:html={md(a)} />
            ))}
          </ol>
        </section>
      )
    }

    {
      d.referencias.length > 0 && (
        <section id="referencias" class="bloque">
          <h2>Para saber más</h2>
          <ul class="referencias">
            {d.referencias.map((r) => (
              <li>
                {r.url ? (
                  <a href={r.url} target="_blank" rel="noopener">
                    {r.titulo}
                  </a>
                ) : (
                  <strong>{r.titulo}</strong>
                )}
                {r.autor && <span class="autor"> · {r.autor}</span>}
                {r.nota && <p>{r.nota}</p>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      d.creditos.length > 0 && (
        <section class="bloque creditos">
          <h2>Créditos</h2>
          <dl>
            {d.creditos.map((c) => (
              <div>
                <dt>{c.rol}</dt>
                <dd>{c.nombre}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      colaboradores.length > 0 && (
        <section class="bloque colaboracion">
          <h2>En colaboración con</h2>
          <ul>
            {colaboradores.map((c) => (
              <li>
                <p class="colab-nombre">
                  {c.data.nombre}
                  {c.data.persona && <span>{c.data.persona}</span>}
                </p>
                {(c.data.youtube || c.data.instagram) && (
                  <p class="colab-enlaces">
                    {c.data.youtube && (
                      <a class="boton secundario toque" href={c.data.youtube} target="_blank" rel="noopener">
                        YouTube<span class="solo-lectores"> de {c.data.nombre}</span>
                      </a>
                    )}
                    {c.data.instagram && (
                      <a class="boton secundario toque" href={c.data.instagram} target="_blank" rel="noopener">
                        Instagram<span class="solo-lectores"> de {c.data.nombre}</span>
                      </a>
                    )}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="paginacion" aria-label="Otras canciones">
      {anterior ? <a class="toque" href={url(`canciones/${anterior.id}/`)}>← {anterior.data.titulo}</a> : <span />}
      <BotonAzar class="boton secundario" texto="Otra al azar" />
      {siguiente ? <a class="toque" href={url(`canciones/${siguiente.id}/`)}>{siguiente.data.titulo} →</a> : <span />}
    </nav>
  </div>
  </main>
</Base>

<script>
  const letra = document.getElementById('letra-contenido');
  document.querySelectorAll<HTMLInputElement>('[data-alterna]').forEach((c) =>
    c.addEventListener('change', () => letra?.classList.toggle(c.dataset.alterna!, c.checked)),
  );

  // En pantallas estrechas la presentación se recorta con «Leer más» para que la letra no quede tan lejos.
  const texto = document.getElementById('presentacion-texto');
  const masBtn = document.getElementById('leer-mas');
  if (texto && masBtn && matchMedia('(max-width: 899px)').matches && texto.scrollHeight > 420) {
    texto.classList.add('recortada');
    masBtn.hidden = false;
    masBtn.addEventListener('click', () => {
      const abierta = texto.classList.toggle('recortada') === false;
      masBtn.setAttribute('aria-expanded', String(abierta));
      masBtn.textContent = abierta ? 'Leer menos' : 'Leer más';
    });
  }
</script>

<style>
  .cabeza {
    padding: 1.5rem 0 7rem;
  }

  @media (min-width: 900px) {
    .cabeza {
      padding-bottom: 9rem;
    }
  }

  .migas {
    margin: 0 0 2.5rem;
    font-size: 0.95rem;
  }

  .migas a {
    text-decoration: none;
    opacity: 0.85;
  }

  .migas a::before {
    content: '← ';
  }

  .migas a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .estilo {
    margin: 0 0 0.6rem;
    font-weight: 700;
    color: var(--senal);
  }

  .cabeza h1 {
    font-size: clamp(2.3rem, 6vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.035em;
    max-width: 22ch;
    margin-bottom: 1.25rem;
  }

  .resumen {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--banda-suave);
    max-width: 46rem;
    margin: 0 0 1.25rem;
  }

  .temas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .temas li {
    font-size: 0.85rem;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.45);
  }

  /* El vídeo sube y pisa la banda azul. */
  .portada {
    display: grid;
    gap: 1.5rem;
    margin-top: -5rem;
  }

  @media (min-width: 900px) {
    .portada {
      margin-top: -7rem;
      grid-template-columns: 1fr 18rem;
      align-items: start;
    }

    .recursos {
      margin-top: 7rem;
    }
  }

  .portada-video .video {
    box-shadow: 0 24px 48px -24px rgb(21 26 58 / 0.55);
    margin-bottom: 1rem;
  }

  .recursos {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    background: var(--tarjeta);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    box-shadow: var(--sombra-2);
  }

  .recursos h2 {
    font-size: 1.35rem;
    margin-bottom: 0.25rem;
  }

  .escuchar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
    font-weight: 700;
  }

  .escuchar > a {
    flex: 1;
    justify-content: center;
  }

  /* Barra de secciones fija (solo móvil; en escritorio el índice va en «Para clase»). */
  .barra-indice {
    --barra: 3.25rem;
    position: sticky;
    top: 0;
    z-index: 5;
    margin: 2rem -1rem 0;
    background: var(--papel);
    border-bottom: 1px solid var(--linea);
    box-shadow: 0 6px 12px -10px rgb(21 26 58 / 0.4);
  }

  .barra-indice ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0.25rem 1rem;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .barra-indice a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.85rem;
    border-radius: 999px;
    white-space: nowrap;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .barra-indice a:hover {
    background: var(--linea);
  }

  @media (min-width: 900px) {
    .barra-indice {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .recursos .indice {
      display: none;
    }
  }

  .recortada {
    max-height: 18rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(#000 70%, transparent);
    mask-image: linear-gradient(#000 70%, transparent);
  }

  .leer-mas {
    margin-top: 0.75rem;
  }

  /* El estilo de .boton pisa el atributo hidden: se fuerza aquí, y en escritorio nunca se muestra. */
  .leer-mas[hidden] {
    display: none;
  }

  @media (min-width: 900px) {
    .leer-mas {
      display: none;
    }
  }

  .indice {
    margin: 0.75rem 0 0;
    padding: 0.75rem 0 0;
    border-top: 1px solid var(--linea);
    list-style: none;
    font-size: 0.95rem;
  }

  .indice li {
    padding: 0.2rem 0;
  }

  .bloque {
    margin-top: 4rem;
  }

  .bloque > h2,
  #letra > h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.4rem);
  }

  .presentacion {
    font-size: 1.15rem;
    max-width: 46rem;
  }

  #letra > h2 {
    margin-bottom: 0.75rem;
  }

  /* Panel de opciones: queda fijo arriba al recorrer la letra (debajo de la barra de secciones en móvil). */
  .interruptores {
    position: sticky;
    top: 3.3rem;
    z-index: 4;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    padding: 0.15rem 1rem;
    background: var(--tarjeta);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    box-shadow: var(--sombra-1);
    font-size: 1rem;
    font-weight: 700;
    width: fit-content;
    max-width: 100%;
  }

  /* En escritorio vuelven a su sitio: a la derecha del título, sin panel ni posición fija. */
  @media (min-width: 900px) {
    #letra {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 1.5rem;
    }

    #letra > :not(h2):not(.interruptores) {
      grid-column: 1 / -1;
    }

    .interruptores {
      position: static;
      padding: 0;
      background: none;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      gap: 0.25rem 1.25rem;
      font-size: 0.95rem;
    }
  }

  .interruptores label {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.4rem;
    cursor: pointer;
  }

  .interruptores input {
    appearance: none;
    position: relative;
    width: 2.9rem;
    height: 1.6rem;
    margin: 0;
    border-radius: 999px;
    background: var(--borde-ui);
    cursor: pointer;
    transition: background 0.25s ease;
  }

  .interruptores input::before {
    content: '';
    position: absolute;
    top: 0.2rem;
    left: 0.2rem;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .interruptores input:checked {
    background: var(--senal);
  }

  .interruptores input:checked::before {
    background: #151a3a;
  }

  .interruptores input:checked::before {
    transform: translateX(1.3rem);
  }

  .interruptores input:focus-visible {
    outline: 2px solid var(--azul);
    outline-offset: 2px;
  }

  .seccion h3 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--acento);
    margin: 2.5rem 0 0.75rem;
  }

  .seccion + .seccion {
    margin-top: 2rem;
  }

  /* Cada verso tiene dos columnas fijas en pantallas anchas (letra | explicación): nada se recoloca al activar las
     explicaciones, solo se despliega la altura y aparece el texto. Cada verso entra con un pequeño retraso (--i). */
  .verso {
    --t: 0.65s cubic-bezier(0.4, 0, 0.2, 1);
    --d: calc(var(--i, 0) * 45ms);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 0.15rem 0;
    border-block: 1px dashed transparent;
    transition:
      padding var(--t),
      margin var(--t),
      border-color var(--t);
  }

  @media (min-width: 900px) {
    .verso {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      column-gap: 2.5rem;
    }
  }

  .con-explicaciones .verso.explicado {
    padding: 0.9rem 0;
    margin: 0.5rem 0;
    border-color: var(--linea);
    transition-delay: var(--d);
  }

  .con-explicaciones .verso.explicado + .verso.explicado {
    margin-top: -0.5rem;
    border-top-color: transparent;
  }

  .original {
    position: relative;
    padding-left: 2.25rem;
  }

  /* Sin explicaciones: aro amarillo; con ellas: relleno amarillo. Así el número se lee siempre con buen contraste. */
  .marca-num {
    position: absolute;
    left: 0;
    top: 0.2rem;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--senal);
    color: var(--tinta);
    font-size: 0.75rem;
    font-weight: 700;
    transition:
      background 0.5s ease,
      color 0.5s ease;
  }

  .con-explicaciones .marca-num {
    background: var(--senal);
    color: #151a3a;
    transition-delay: var(--d);
  }

  .texto {
    font-family: var(--f-titulo);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    white-space: pre-line;
    margin: 0;
  }

  /* Bloques que se despliegan: la fila pasa de 0fr a 1fr para animar la altura. */
  .plegable {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows var(--t),
      opacity 0.35s ease,
      visibility 0s linear 0.65s;
  }

  .plegable > div {
    overflow: hidden;
    min-height: 0;
  }

  .con-traduccion .plegable-traduccion,
  .con-explicaciones .plegable-explicacion {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transition:
      grid-template-rows var(--t) var(--d),
      opacity 0.5s ease calc(var(--d) + 0.15s),
      visibility 0s;
  }

  .traduccion {
    white-space: pre-line;
    font-style: italic;
    color: var(--tinta-suave);
    margin: 0;
    padding-top: 0.35rem;
  }

  .plegable-explicacion > div {
    padding-top: 0.6rem;
  }

  @media (min-width: 900px) {
    .plegable-explicacion > div {
      padding-top: 0;
    }
  }

  .explicacion {
    background: var(--tarjeta);
    border: 1px solid var(--linea);
    border-left: 4px solid var(--azul);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    font-size: 0.98rem;
    transform: translateY(-0.5rem);
    transition: transform var(--t);
  }

  @media (min-width: 900px) {
    .explicacion {
      transform: translateX(-1rem);
    }
  }

  .con-explicaciones .explicacion {
    transform: none;
    transition-delay: calc(var(--d) + 0.1s);
  }

  .explicacion :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .verso,
    .plegable,
    .explicacion,
    .marca-num {
      transition: none;
    }
  }

  .actividades {
    max-width: 46rem;
    padding-left: 1.4rem;
  }

  .actividades li {
    margin-bottom: 0.6rem;
  }

  .actividades :global(p) {
    margin: 0;
  }

  .referencias {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 46rem;
  }

  .referencias li {
    padding: 0.75rem 0;
    border-top: 1px solid var(--linea);
  }

  .referencias .autor {
    color: var(--tinta-suave);
  }

  .referencias p {
    margin: 0.2rem 0 0;
    font-size: 0.95rem;
    color: var(--tinta-suave);
  }

  .colaboracion ul {
    display: grid;
    gap: 1.5rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    list-style: none;
    padding: 0;
