---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { cancionesOrdenadas, url } from '../lib/util';

const pagina = await getEntry('paginas', 'conoceme');
if (!pagina) throw new Error('Falta src/content/paginas/conoceme.md');
const p = pagina.data;
const { Content } = await render(pagina);
const foto = p.foto && (/^https?:/.test(p.foto) ? p.foto : url(p.foto));
const canciones = await cancionesOrdenadas();
---

<Base titulo={p.titulo} descripcion={p.lema} actual="conoceme">
  <main id="contenido" tabindex="-1">
  <div class="banda con-brillo cabeza">
    <div class="envoltura cabeza-dentro">
      <div>
        <h1>{p.nombre}</h1>
        {p.lema && <p class="lema">{p.lema}</p>}
        {
          p.enlaces.length > 0 && (
            <ul class="enlaces">
              {p.enlaces.map((e) => (
                <li>
                  <a href={e.url} target="_blank" rel="noopener">
                    {e.nombre}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      {
        foto && (
          <div class="retrato">
            <img class="foto" src={foto} alt={`Retrato de ${p.nombre}`} width="768" height="1365" />
            <span class="sello" aria-hidden="true">
              <svg viewBox="0 0 32 32"><path d="M2 16c3-9 6-9 9 0s6 9 9 0 6-9 10 0" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" /></svg>
            </span>
          </div>
        )
      }
    </div>
  </div>

  <div class="envoltura cuerpo">
    <div class="prosa bio"><Content /></div>

    <aside class="lateral">
      <a class="boton" href={url('#canciones')}>Ver las {canciones.length} canciones</a>
    </aside>
  </div>
  </main>
</Base>

<style>
  .cabeza {
    padding: 2rem 0 0;
    overflow: hidden;
  }

  .cabeza-dentro {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 800px) {
    .cabeza-dentro {
      grid-template-columns: 1fr 20rem;
      gap: 4rem;
    }
  }

  .cabeza-dentro > div:first-child {
    padding-bottom: 3rem;
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    max-width: 9ch;
    margin-bottom: 1.5rem;
  }

  .lema {
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    color: var(--banda-suave);
    max-width: 34rem;
    margin: 0 0 2rem;
  }

  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .enlaces a {
    display: inline-block;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.5);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .enlaces a:hover {
    background: var(--senal);
    border-color: var(--senal);
    color: #151a3a;
  }

  /* Foto redonda con un aro amarillo desplazado y el sello de la onda del logo. */
  .retrato {
    position: relative;
    width: min(100%, 18rem);
    aspect-ratio: 1;
    justify-self: center;
    margin-bottom: 3rem;
  }

  .retrato::before {
    content: '';
    position: absolute;
    inset: -0.7rem;
    border-radius: 50%;
    border: 3px solid var(--senal);
    transform: translate(0.6rem, 0.5rem);
  }

  .foto {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
  }

  .sello {
    position: absolute;
    right: 0.2rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 4.2rem;
    height: 4.2rem;
    border-radius: 50%;
    background: var(--senal);
    color: #151a3a;
    border: 4px solid var(--banda);
    transform: rotate(-12deg);
  }

  .sello svg {
    width: 62%;
    height: auto;
  }

  .cuerpo {
    display: grid;
    gap: 3rem;
    padding-top: 3.5rem;
  }

  @media (min-width: 900px) {
    .cuerpo {
      grid-template-columns: minmax(0, 40rem) 1fr;
      gap: 5rem;
    }
  }

  .bio {
    font-size: 1.15rem;
  }

  .bio :global(p:first-child) {
    font-size: 1.3rem;
  }

  .lateral {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
  }

</style>
