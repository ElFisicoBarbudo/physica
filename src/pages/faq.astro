---
// Preguntas frecuentes. El contenido se edita desde Pages CMS («Preguntas frecuentes»), en src/faq.json.
import Base from '../layouts/Base.astro';
import { md, mdInline, url } from '../lib/util';
import faq from '../faq.json';

// Los enlaces internos se escriben como /feedback/ y se adaptan aquí al `base` de la web.
const enlaces = (html: string) => html.replace(/href="\/(?!\/)/g, `href="${url('')}`);
const preguntas = faq.preguntas.filter((p) => p.pregunta?.trim());
---

<Base titulo={faq.titulo} descripcion="Respuestas a las dudas habituales sobre las canciones, las fichas y cómo usarlas en clase." actual="faq">
  <main id="contenido" tabindex="-1">
    <div class="banda con-brillo cabeza">
      <div class="envoltura">
        <p class="sobre">Dudas</p>
        <h1>{faq.titulo}</h1>
        {faq.intro && <p class="lema" set:html={enlaces(mdInline(faq.intro))} />}
      </div>
    </div>

    <div class="envoltura cuerpo">
      {faq.borrador && <p class="aviso-ejemplo">Estas respuestas están pendientes de revisión.</p>}
      <div class="preguntas">
        {
          preguntas.map((p) => (
            <details class="pregunta">
              <summary>
                <span>{p.pregunta}</span>
              </summary>
              <div class="prosa respuesta" set:html={enlaces(md(p.respuesta ?? ''))} />
            </details>
          ))
        }
      </div>
    </div>
  </main>
</Base>

<style>
  .cabeza {
    padding: 2.5rem 0 3rem;
  }

  .sobre {
    color: var(--banda-suave);
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin-bottom: 1.25rem;
  }

  .lema {
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    color: var(--banda-suave);
    max-width: 38rem;
    margin: 0;
  }

  .lema :global(a) {
    color: inherit;
  }

  .cuerpo {
    padding-top: 2.5rem;
    max-width: 52rem;
  }

  .preguntas {
    display: grid;
    gap: 0.75rem;
  }

  .pregunta {
    background: var(--tarjeta);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    box-shadow: var(--sombra-1);
  }

  .pregunta[open] {
    border-left: 5px solid var(--senal);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    min-height: 48px;
    cursor: pointer;
    font-family: var(--f-titulo);
    font-weight: 700;
    font-size: 1.1rem;
    list-style: none;
    border-radius: var(--radio);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Signo + que gira hasta ser una × al abrir. */
  summary::after {
    content: '+';
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--acento-suave);
    color: var(--tinta);
    font-size: 1.4rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .pregunta[open] summary::after {
    transform: rotate(45deg);
  }

  .respuesta {
    padding: 0 1.25rem 1.1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    summary::after {
      transition: none;
    }
  }
</style>
