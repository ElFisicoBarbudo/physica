---
// Preguntas frecuentes. El contenido se edita desde Pages CMS («Preguntas frecuentes»), en src/faq.json.
import Base from '../layouts/Base.astro';
import { md, mdInline, url } from '../lib/util';
import faq from '../faq.json';

// Los enlaces internos se escriben como /feedback/ y se adaptan aquí al `base` de la web.
const enlaces = (html: string) => html.replace(/href="\/(?!\/)/g, `href="${url('')}`);
const preguntas = faq.preguntas.filter((p) => p.pregunta?.trim());
---

<Base titulo={faq.titulo} descripcion="Respuestas a las dudas habituales sobre las canciones, las fichas y cómo usarlas en clase." actual="faq">
  <main id="contenido" tabindex="-1">
    <div class="banda con-brillo cabeza">
      <div class="envoltura">
        <p class="sobre">Dudas</p>
        <h1>{faq.titulo}</h1>
        {faq.intro && <p class="lema" set:html={enlaces(mdInline(faq.intro))} />}
      </div>
    </div>

    <div class="envoltura cuerpo">
      {faq.borrador && <p class="aviso-ejemplo">Estas respuestas están pendientes de revisión.</p>}
      <div class="preguntas">
        {
          preguntas.map((p) => (
            <section class="pregunta">
              <h2>{p.pregunta}</h2>
              <div class="prosa respuesta" set:html={enlaces(md(p.respuesta ?? ''))} />
            </section>
          ))
        }
      </div>
    </div>
  </main>
</Base>

<style>
  .cabeza {
    padding: 2.5rem 0 3rem;
  }

  .sobre {
    color: var(--banda-suave);
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin-bottom: 1.25rem;
  }

  .lema {
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    color: var(--banda-suave);
    max-width: 38rem;
    margin: 0;
  }

  .lema :global(a) {
    color: inherit;
  }

  .cuerpo {
    padding-top: 2.5rem;
  }

  /* Todas las respuestas a la vista, sin acordeón: una lista que se lee de arriba abajo,
     con una línea fina entre pregunta y pregunta. */
  .preguntas {
    display: grid;
    max-width: 52rem;
  }

  .pregunta {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--linea);
  }

  .pregunta:first-child {
    padding-top: 0.5rem;
  }

  .pregunta h2 {
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
    line-height: 1.2;
    margin: 0 0 0.6rem;
  }

  .respuesta {
    max-width: 62ch;
  }

  .respuesta :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
