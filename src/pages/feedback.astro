---
// Formulario de feedback. Los mensajes se envían con Web3Forms (https://web3forms.com):
// funciona en una web estática, es gratis hasta 250 mensajes al mes y el correo de destino
// se guarda en su panel, así que nunca aparece en el HTML.
// Anti-bots: campo trampa (botcheck), tiempo mínimo para rellenar y hCaptcha de Web3Forms.
import Base from '../layouts/Base.astro';
import { CLAVE_FEEDBACK, NOMBRE, cancionesOrdenadas } from '../lib/util';

const canciones = await cancionesOrdenadas();
---

<Base titulo="Enviar feedback" descripcion={`Cuéntame qué mejorarías de ${NOMBRE}: errores, ideas o cómo lo has usado en clase.`} actual="feedback">
  <main id="contenido" tabindex="-1">
    <div class="banda con-brillo cabeza">
      <div class="envoltura">
        <p class="chapa"><span>Beta</span> Web en pruebas</p>
        <h1>¿Qué mejorarías?</h1>
        <p class="lema">
          Esta web acaba de nacer y todavía tiene costuras. Si has encontrado un error, echas algo en falta o la has usado en clase, me vendría genial que me lo
          contaras. Lo leo todo.
        </p>
      </div>
    </div>

    <div class="envoltura cuerpo">
      <form
        class="formulario"
        action="https://api.web3forms.com/submit"
        method="POST"
        data-clave={CLAVE_FEEDBACK ? 'si' : 'no'}
      >
        {!CLAVE_FEEDBACK && <p class="aviso">El formulario todavía no está activo. Vuelve en unos días.</p>}

        <input type="hidden" name="access_key" value={CLAVE_FEEDBACK} />
        <input type="hidden" name="subject" value={`Feedback de ${NOMBRE}`} />
        <input type="hidden" name="from_name" value={NOMBRE} />
        <input type="hidden" name="pagina" value="" />
        <!-- Campo trampa: las personas no lo ven; si llega marcado, Web3Forms descarta el mensaje. -->
        <input type="checkbox" name="botcheck" class="trampa" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="campo">
          <label for="f-mensaje">Tu mensaje <span class="obligatorio">(obligatorio)</span></label>
          <textarea id="f-mensaje" name="mensaje" rows="7" required minlength="10" maxlength="4000"
            placeholder="Un error en una explicación, una idea para una actividad, una canción que echas de menos…"></textarea>
        </div>

        <div class="fila">
          <div class="campo">
            <label for="f-tipo">¿De qué se trata?</label>
            <select id="f-tipo" name="tipo">
              <option>Una idea o sugerencia</option>
              <option>Un error en la web</option>
              <option>Un error en una explicación de física</option>
              <option>Cómo la he usado en clase</option>
              <option>Otra cosa</option>
            </select>
          </div>
          <div class="campo">
            <label for="f-cancion">¿Sobre alguna canción?</label>
            <select id="f-cancion" name="cancion">
              <option value="">Sobre la web en general</option>
              {canciones.map((c) => <option value={c.data.titulo} data-ruta={`canciones/${c.id}/`}>{c.data.titulo}</option>)}
            </select>
          </div>
        </div>

        <div class="fila">
          <div class="campo">
            <label for="f-perfil">Eres…</label>
            <select id="f-perfil" name="perfil">
              <option value="">Prefiero no decirlo</option>
              <option>Docente de secundaria o bachillerato</option>
              <option>Docente de universidad</option>
              <option>Estudiante</option>
              <option>Curioso o curiosa de la física</option>
            </select>
          </div>
          <div class="campo">
            <label for="f-nombre">Tu nombre <span class="opcional">(opcional)</span></label>
            <input id="f-nombre" name="name" type="text" autocomplete="name" maxlength="100" />
          </div>
        </div>

        <div class="campo">
          <label for="f-correo">Tu correo <span class="opcional">(opcional, solo si quieres respuesta)</span></label>
          <input id="f-correo" name="email" type="email" autocomplete="email" inputmode="email" maxlength="200" />
        </div>

        <!-- hCaptcha de Web3Forms: solo se comprueba si está activado en su panel. -->
        <div class="h-captcha" data-captcha="true"></div>

        <button class="boton enviar" type="submit" disabled={!CLAVE_FEEDBACK}>Enviar feedback</button>
        <p class="estado" role="status" aria-live="polite"></p>
        <p class="letra-pequena">Tus datos solo se usan para leer y, si dejas tu correo, contestar a tu mensaje. No se publican ni se ceden a nadie.</p>
      </form>
    </div>
  </main>
</Base>

{CLAVE_FEEDBACK && <script is:inline src="https://web3forms.com/client/script.js" async defer></script>}

<script>
  // Segundos mínimos entre que se carga la página y se envía: una persona tarda más en escribir; un bot, no.
  const MINIMO = 4;
  const cargada = Date.now();

  const form = document.querySelector<HTMLFormElement>('.formulario')!;
  const estado = form.querySelector<HTMLElement>('.estado')!;
  const boton = form.querySelector<HTMLButtonElement>('.enviar')!;
  const cancion = form.querySelector<HTMLSelectElement>('#f-cancion')!;
  const pagina = form.querySelector<HTMLInputElement>('[name="pagina"]')!;

  // Si vienes de una canción, queda elegida en el desplegable.
  const desde = new URLSearchParams(location.search).get('desde') ?? '';
  pagina.value = desde || document.referrer;
  const opcion = [...cancion.options].find((o) => o.dataset.ruta && desde.endsWith(o.dataset.ruta));
  if (opcion) opcion.selected = true;

  const mostrar = (texto: string, tipo: 'ok' | 'error' | '') => {
    estado.textContent = texto;
    estado.dataset.tipo = tipo;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (form.dataset.clave !== 'si') return;
    const datos = new FormData(form);
    if (datos.get('botcheck')) return;
    if ((Date.now() - cargada) / 1000 < MINIMO) {
      mostrar('Vas muy rápido. Espera un par de segundos y vuelve a enviarlo.', 'error');
      return;
    }
    if (form.querySelector('.h-captcha iframe') && !datos.get('h-captcha-response')) {
      mostrar('Marca la casilla de «Soy humano» antes de enviar.', 'error');
      return;
    }

    boton.disabled = true;
    mostrar('Enviando…', '');
    try {
      const r = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: datos });
      const json = await r.json();
      if (!r.ok || !json.success) throw new Error(json.message);
      form.reset();
      mostrar('¡Recibido! Muchas gracias por ayudarme a mejorar la web.', 'ok');
    } catch {
      mostrar('No se ha podido enviar. Inténtalo de nuevo dentro de un rato.', 'error');
    } finally {
      boton.disabled = false;
      // El captcha solo vale para un envío.
      (window as { hcaptcha?: { reset: () => void } }).hcaptcha?.reset();
    }
  });
</script>

<style>
  .cabeza {
    padding: 2.5rem 0 3rem;
  }

  .chapa {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1rem;
    font-weight: 700;
    color: var(--banda-suave);
  }

  .chapa span {
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--senal);
    color: #151a3a;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin-bottom: 1.25rem;
  }

  .lema {
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    color: var(--banda-suave);
    max-width: 38rem;
    margin: 0;
  }

  .cuerpo {
    padding-top: 2.5rem;
  }

  .formulario {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
    background: var(--tarjeta);
    border: 1px solid var(--linea);
    border-top: 5px solid var(--senal);
    border-radius: var(--radio);
    padding: clamp(1.25rem, 4vw, 2rem);
    box-shadow: var(--sombra-1);
  }

  .fila {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .fila {
      grid-template-columns: 1fr 1fr;
    }
  }

  .campo {
    display: grid;
    gap: 0.35rem;
  }

  label {
    font-weight: 700;
  }

  .opcional,
  .obligatorio {
    font-weight: 400;
    color: var(--tinta-suave);
    font-size: 0.9em;
  }

  input,
  select,
  textarea {
    font: inherit;
    color: var(--tinta);
    background: var(--papel);
    border: 1.5px solid var(--borde-ui);
    border-radius: 10px;
    padding: 0.7rem 0.85rem;
    min-height: 48px;
    width: 100%;
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    border-color: var(--acento);
    border-radius: 10px;
  }

  .trampa {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .h-captcha:empty {
    display: none;
  }

  .enviar {
    justify-self: start;
    min-height: 48px;
  }

  .enviar:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media (max-width: 520px) {
    .enviar {
      justify-self: stretch;
    }
  }

  .estado {
    margin: 0;
    font-weight: 700;
  }

  .estado:empty {
    display: none;
  }

  .estado[data-tipo='ok'] {
    color: #157a3c;
  }

  .estado[data-tipo='error'] {
    color: #b3261e;
  }

  @media (prefers-color-scheme: dark) {
    .estado[data-tipo='ok'] {
      color: #6fdc96;
    }

    .estado[data-tipo='error'] {
      color: #ff9a92;
    }
  }

  .letra-pequena {
    margin: 0;
    font-size: 0.88rem;
    color: var(--tinta-suave);
  }

  .aviso {
    margin: 0;
  }
</style>
