---
import Base from '../layouts/Base.astro';
import Cuerda from '../components/Cuerda.astro';
import TarjetaCancion from '../components/TarjetaCancion.astro';
import { NOMBRE, cancionesOrdenadas, url } from '../lib/util';

const canciones = await cancionesOrdenadas();
const temas = [...new Set(canciones.flatMap((c) => c.data.temas))].sort((a, b) => a.localeCompare(b, 'es'));
const estilos = new Set(canciones.map((c) => c.data.estilo).filter(Boolean)).size;
---

<Base>
  <main>
    <section class="banda portada" data-zona-cuerda>
      <div class="envoltura">
        <h1>La física también se canta</h1>
        <p class="entradilla">
          Canciones con videoclip sobre fenómenos físicos reales. Cada una trae la letra explicada verso a verso, actividades y una ficha lista para imprimir y
          llevar al aula.
        </p>
        <div class="acciones">
          <a class="boton" href="#canciones">Ver las canciones</a>
          <a class="boton secundario" href="#como-usar">Cómo usarlas en clase</a>
        </div>
      </div>
      <div class="envoltura cuerda-envoltura">
        <Cuerda />
      </div>
    </section>

    <section id="canciones" class="canciones envoltura">
      <div class="canciones-cabecera">
        <div>
          <h2>Canciones</h2>
          <p class="cuenta">{canciones.length} canciones en {estilos} estilos musicales distintos.</p>
        </div>
        {
          temas.length > 1 && (
            <div class="filtros" role="group" aria-label="Filtrar por tema">
              <button type="button" class="filtro" aria-pressed="true" data-tema="">
                Todos los temas
              </button>
              {temas.map((t) => (
                <button type="button" class="filtro" aria-pressed="false" data-tema={t}>
                  {t}
                </button>
              ))}
            </div>
          )
        }
      </div>
      <ul class="rejilla">{canciones.map((c) => <TarjetaCancion cancion={c} />)}</ul>
    </section>

    <section id="como-usar" class="como-usar envoltura">
      <h2>Cómo usarlas en clase</h2>
      <ol class="pasos">
        <li>
          <h3>Elige una canción</h3>
          <p>Filtra por tema y quédate con la que encaje con lo que estás dando.</p>
        </li>
        <li>
          <h3>Ponla en clase</h3>
          <p>Proyecta el videoclip. Si está en inglés, activa la traducción y aparece bajo cada verso.</p>
        </li>
        <li>
          <h3>Desgrana la letra</h3>
          <p>Activa las explicaciones: cada verso marcado cuenta la física que esconde. Úsalas para guiar el debate.</p>
        </li>
        <li>
          <h3>Reparte la ficha</h3>
          <p>Descarga el PDF con la letra explicada, actividades y un código QR que lleva al vídeo.</p>
        </li>
      </ol>
    </section>

    <section class="proyecto envoltura">
      <div class="proyecto-texto">
        <h2>Por qué canciones</h2>
        <p>
          Una canción se queda en la cabeza mucho más que un párrafo del libro de texto. {NOMBRE} aprovecha eso: cada letra se apoya en física real, de la gravedad
          de Newton a la radiación de Cherenkov, y cada verso importante viene con una explicación rigurosa y en lenguaje claro.
        </p>
        <p>
          Las canciones son de <a href={url('conoceme/')}>El Físico Barbudo</a>, y los materiales son de uso libre para cualquier docente.
        </p>
      </div>
      <ul class="objetivos">
        <li>
          <strong>Despertar la curiosidad</strong>
          <span>con un formato cercano: una canción y su videoclip.</span>
        </li>
        <li>
          <strong>Explicar la física que hay detrás</strong>
          <span>de cada verso, con rigor y sin rodeos.</span>
        </li>
        <li>
          <strong>Dar material listo para usar</strong>
          <span>presentación, actividades, referencias y ficha imprimible.</span>
        </li>
      </ul>
    </section>
  </main>
</Base>

<script>
  const botones = document.querySelectorAll<HTMLButtonElement>('.filtro');
  const tarjetas = document.querySelectorAll<HTMLElement>('.tarjeta');
  botones.forEach((b) =>
    b.addEventListener('click', () => {
      const tema = b.dataset.tema ?? '';
      botones.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      tarjetas.forEach((t) => {
        t.hidden = !!tema && !(t.dataset.temas ?? '').split('|').includes(tema);
      });
    }),
  );
</script>

<style>
  .portada {
    overflow: hidden;
    padding: 3rem 0 2.5rem;
  }

  @media (min-width: 900px) {
    .portada {
      padding-top: 4.5rem;
    }
  }

  .portada h1 {
    font-size: clamp(3rem, 10vw, 7.5rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    max-width: 11ch;
    margin-bottom: 1.75rem;
  }

  .entradilla {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    max-width: 38rem;
    color: var(--banda-suave);
    margin: 0 0 2rem;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cuerda-envoltura {
    margin-top: 3.5rem;
  }

  .canciones {
    padding-top: 4.5rem;
  }

  .canciones-cabecera {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .canciones h2,
  .como-usar h2,
  .proyecto h2 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
  }

  .canciones h2 {
    margin-bottom: 0.25rem;
  }

  .cuenta {
    margin: 0;
    color: var(--tinta-suave);
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .filtro {
    font: inherit;
    font-size: 0.88rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--linea);
    background: var(--tarjeta);
    color: var(--tinta);
    cursor: pointer;
  }

  .filtro:hover {
    border-color: var(--acento);
  }

  .filtro[aria-pressed='true'] {
    background: var(--acento);
    border-color: var(--acento);
    color: var(--sobre-acento);
  }

  .rejilla {
    display: grid;
    gap: 2.5rem 1.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    padding: 0;
    margin: 0;
  }

  .como-usar {
    margin-top: 6rem;
  }

  /* Cuatro pasos en orden: la numeración es real, así que se muestra. */
  .pasos {
    list-style: none;
    counter-reset: paso;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }

  .pasos li {
    counter-increment: paso;
    border-top: 3px solid var(--acento);
    padding-top: 1rem;
  }

  .pasos li::before {
    content: counter(paso);
    display: block;
    font-family: var(--f-titulo);
    font-weight: 800;
    font-size: 3.2rem;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--acento);
    margin-bottom: 0.75rem;
  }

  .pasos h3 {
    font-size: 1.35rem;
    margin-bottom: 0.4rem;
  }

  .pasos p {
    margin: 0;
    color: var(--tinta-suave);
  }

  .proyecto {
    display: grid;
    gap: 2.5rem;
    margin-top: 6rem;
  }

  @media (min-width: 900px) {
    .proyecto {
      grid-template-columns: 1.15fr 1fr;
      gap: 5rem;
      align-items: end;
    }
  }

  .proyecto-texto p {
    font-size: 1.15rem;
    max-width: 38rem;
  }

  .objetivos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .objetivos li {
    background: var(--acento-suave);
    border-radius: 12px;
    padding: 1rem 1.2rem;
  }

  .objetivos strong {
    display: block;
    font-family: var(--f-titulo);
    font-size: 1.2rem;
    letter-spacing: -0.015em;
  }

  .objetivos span {
    color: var(--tinta-suave);
  }
</style>
